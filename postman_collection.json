          }
        },
        {
          "name": "POST - Tolak Pembayaran",
          "request": { "method": "POST", "url": "{{base_url}}/api/orders/2/reject" }
        },
        {
          "name": "PATCH - Update Status Order",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/orders/1/status",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"siap\"\n}" }
          }
        },
        {
          "name": "DELETE - Hapus Order",
          "request": { "method": "DELETE", "url": "{{base_url}}/api/orders/3" }
        }
      ]
    },
    {

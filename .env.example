# Gemini AI (optional)
GEMINI_API_KEY=

# Public URL where this application is hosted
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
# Optional comma-separated browser origins for cross-origin access.
# Leave empty when frontend and API use the same origin.
CORS_ORIGIN=

# Server-to-server Smart Tag integration URL. Do not use a private LAN IP in production.
SMART_TAG_API_URL=https://smarttag.ngolab.online/
# Isi access token hasil login Smart Tag jika endpoint tulis memakai Bearer JWT.
SMART_TAG_ACCESS_TOKEN=
# Isi hanya jika Smart Tag memang menyediakan API key header x-api-key.
SMART_TAG_API_KEY=

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gesture_eats

# Use long random values in production. Never commit real secrets.
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Folder bukti pembayaran. WAJIB berada di luar root proyek, karena root proyek dilayani sebagai
# berkas statis (pada mode dev oleh Vite, pada produksi oleh express.static). Jika folder ini berada
# di dalam root, bukti pembayaran dapat diunduh tanpa autentikasi dan aplikasi menolak start.
# Pada hosting yang menukar rilis lewat symlink (current -> releases/<ts>), arahkan ke folder di luar
# pohon rilis agar bukti lama tidak tertinggal setiap deploy.
PAYMENT_PROOF_PATH=../user_billing

# Optional backward-compatible master key. Prefer keys generated from
# the Super Admin "API & Integrasi" page for each integration.
EXTERNAL_API_KEY=replace-with-a-long-random-legacy-key
